# ============================
# Historical Starlink 环境变量
# 复制此文件为 .env 并修改对应值
# ============================

# MySQL
DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=historical_starlink

# Redis（可选，不可用时自动禁用）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 服务器
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false

# JWT 密钥（生产环境务必修改）
JWT_SECRET_KEY=your_secret_key_here

# 上传目录
UPLOAD_DIR=uploads

# 前端端口（开发环境使用）
FRONTEND_PORT=3000

# 邮件验证码（QQ邮箱）
SMTP_USER=xxxx
SMTP_PASSWORD=xxx

# MiniMax API（RAG 知识库 + AI 问答）
MINIMAX_API_KEY=your_minimax_api_key_here
